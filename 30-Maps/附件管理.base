filters:
  and:
    - file.inFolder("Attachments")
formulas:
  引用数: file.backlinks.length
  体积MB: (file.size / 1048576).round(1)
properties:
  formula.引用数:
    displayName: 被引用
  formula.体积MB:
    displayName: 大小(MB)
  file.ext:
    displayName: 类型
views:
  - type: table
    name: 全部附件
    order:
      - file.name
      - file.ext
      - file.folder
      - formula.体积MB
      - formula.引用数
    sort:
      - property: file.size
        direction: DESC
    summaries:
      file.name: Filled
  - type: table
    name: 未被引用的附件
    filters:
      and:
        - formula.引用数 == 0
    order:
      - file.name
      - file.folder
      - formula.体积MB
      - file.ctime
    sort:
      - property: formula.体积MB
        direction: DESC
  - type: table
    name: 大文件（注意仓库体积）
    filters:
      and:
        - formula.体积MB > 20
    order:
      - file.name
      - file.folder
      - formula.体积MB
    sort:
      - property: file.size
        direction: DESC
