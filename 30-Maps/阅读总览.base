filters:
  and:
    - type == "book"
    - '!file.inFolder("50-Meta/Templates")'
formulas:
  未回顾天数: if(last_reviewed, ((today() - last_reviewed) / 86400000).round(0))
  提炼数量: file.backlinks.length
  阅读天数: if(started && finished, ((finished - started) / 86400000).round(0))
properties:
  note.rating:
    displayName: 评分
  note.author:
    displayName: 作者
  note.status:
    displayName: 状态
  note.started:
    displayName: 开始
  note.finished:
    displayName: 读完
  note.medium:
    displayName: 载体
  note.excerpt_pdf:
    displayName: 手写摘录
  note.last_reviewed:
    displayName: 上次回顾
  formula.未回顾天数:
    displayName: 未回顾天数
  formula.提炼数量:
    displayName: 提炼数量
  formula.阅读天数:
    displayName: 阅读天数
views:
  - type: cards
    name: 在读
    filters:
      and:
        - status == "reading"
    order:
      - file.name
      - author
      - started
    sort:
      - property: started
        direction: ASC
    image: note.cover
  - type: table
    name: 全部书籍
    order:
      - file.name
      - author
      - year
      - status
      - rating
      - formula.提炼数量
    sort:
      - property: file.name
        direction: ASC
    summaries:
      file.name: Filled
      rating: Average
  - type: table
    name: 真正改变我的书
    filters:
      and:
        - status == "finished"
    order:
      - file.name
      - author
      - rating
      - formula.提炼数量
    sort:
      - property: formula.提炼数量
        direction: DESC
    limit: 20
  - type: table
    name: 有手写摘录
    filters:
      and:
        - "!excerpt_pdf.isEmpty()"
    order:
      - file.name
      - author
      - excerpt_pdf
      - formula.提炼数量
    sort:
      - property: formula.提炼数量
        direction: ASC
  - type: table
    name: 读完但没提炼
    filters:
      and:
        - status == "finished"
        - formula.提炼数量 == 0
    order:
      - file.name
      - author
      - finished
    sort:
      - property: finished
        direction: ASC
  - type: table
    name: 想读
    filters:
      and:
        - status == "inbox"
    order:
      - file.name
      - author
      - year
